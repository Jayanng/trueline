DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_GMS_TOKEN=
MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# Optional LLM prose layer (OpenAI-compatible). Default: GMI Cloud + DeepSeek V4 Flash.
# Without a key, the guard still runs — comments use engine facts only.
GMI_API_KEY=
GMI_BASE_URL=https://api.gmi-serving.com/v1
GMI_MODEL=deepseek-ai/DeepSeek-V4-Flash
# If console lists a dated flash id, e.g. deepseek-ai/DeepSeek-V4-Flash-0731, set GMI_MODEL to that.

TRUELINE_DRY_RUN=true
TRUELINE_STATE_DB=.trueline/state.db
TRUELINE_CONTRACTS_PATH=contracts/model-change-contracts.json
